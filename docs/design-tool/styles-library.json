    {
      "id": "bento-light",
      "name": "Bento light",
      "scheme": "light",
      "description": "White cards on white or powder-blue, generous 24 px radii, soft shadow.",
      "tokens": {
        "background": "#ffffff",
        "pageTint": "#e7eff9",
        "surface": "#ffffff",
        "surfaceAlt": "#f2f5f9",
        "text": "#1c2433",
        "muted": "#6a7385",
        "accent": "#3a6fe3",
        "accentText": "#ffffff",
        "accentSoft": "#e5edfc",
        "border": "#e3e8f0",
        "track": "#dde3ec",
        "mediaBg": "#1f2633",
        "ok": "#1f9d6b",
        "warn": "#c98a12",
        "danger": "#d94848",
        "info": "#3a6fe3",
        "radius": "24px",
        "radiusSm": "12px",
        "radiusXs": "9px",
        "borderWidth": "0px",
        "shadow": "0 1px 2px rgba(22,34,58,.04), 0 10px 28px rgba(22,34,58,.08)",
        "shadowSm": "0 1px 2px rgba(22,34,58,.08)",
        "backdrop": "none",
        "font": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "spacing": [
          4,
          8,
          12,
          16,
          24,
          32,
          48
        ]
      },
      "components": {
        "card": {
          "background": "$surface",
          "border": "$borderWidth solid $border",
          "borderRadius": "$radius",
          "boxShadow": "$shadow",
          "color": "$text",
          "padding": "$sp3",
          "backdropFilter": "$backdrop"
        },
        "card.title": {
          "fontSize": "15px",
          "fontWeight": "600",
          "color": "$text"
        },
        "button.primary": {
          "background": "$accent",
          "color": "$accentText",
          "border": "none",
          "borderRadius": "$radiusSm",
          "fontWeight": "600",
          "boxShadow": "$shadowSm"
        },
        "button.secondary": {
          "background": "$surfaceAlt",
          "color": "$text",
          "border": "none",
          "borderRadius": "$radiusSm",
          "fontWeight": "500",
          "boxShadow": "none"
        },
        "button.ghost": {
          "background": "transparent",
          "color": "$accent",
          "border": "none",
          "borderRadius": "$radiusSm",
          "fontWeight": "600"
        },
        "chip": {
          "background": "$surfaceAlt",
          "color": "$text",
          "border": "1px solid transparent",
          "borderRadius": "999px",
          "fontWeight": "500"
        },
        "chip.selected": {
          "background": "$accentSoft",
          "color": "$accent",
          "border": "1px solid transparent"
        },
        "tabs": {
          "background": "$surfaceAlt",
          "borderRadius": "14px",
          "padding": "4px",
          "border": "none"
        },
        "tab": {
          "color": "$muted",
          "borderRadius": "$radiusXs",
          "fontWeight": "500"
        },
        "tab.active": {
          "background": "$surface",
          "color": "$text",
          "boxShadow": "$shadowSm",
          "fontWeight": "600"
        },
        "toggle.track": {
          "background": "$track",
          "borderRadius": "999px"
        },
        "toggle.trackOn": {
          "background": "$accent"
        },
        "toggle.knob": {
          "background": "#ffffff",
          "borderRadius": "999px",
          "boxShadow": "0 1px 2px rgba(0,0,0,.25)"
        },
        "input": {
          "background": "$surfaceAlt",
          "color": "$muted",
          "border": "1px solid transparent",
          "borderRadius": "$radiusSm"
        },
        "text.heading": {
          "color": "$text",
          "fontSize": "24px",
          "fontWeight": "700",
          "letterSpacing": "-0.01em"
        },
        "text.body": {
          "color": "$text",
          "fontSize": "14px",
          "fontWeight": "400"
        },
        "text.caption": {
          "color": "$muted",
          "fontSize": "12px",
          "fontWeight": "400"
        },
        "media": {
          "background": "$mediaBg",
          "color": "#ffffff",
          "borderRadius": "$radius",
          "boxShadow": "$shadow"
        },
        "listrow": {
          "background": "transparent",
          "color": "$text",
          "borderBottom": "1px solid $border",
          "borderRadius": "0"
        },
        "navrail": {
          "background": "$surface",
          "border": "$borderWidth solid $border",
          "borderRadius": "$radius",
          "boxShadow": "$shadow",
          "padding": "$sp1",
          "backdropFilter": "$backdrop"
        },
        "navitem": {
          "color": "$muted",
          "borderRadius": "$radiusSm",
          "fontWeight": "500"
        },
        "navitem.active": {
          "background": "$accentSoft",
          "color": "$accent",
          "fontWeight": "600"
        },
        "pill": {
          "borderRadius": "999px",
          "fontWeight": "600",
          "fontSize": "12px"
        },
        "progress.track": {
          "background": "$track",
          "borderRadius": "999px"
        },
        "progress.bar": {
          "background": "$accent",
          "borderRadius": "999px"
        },
        "chart": {
          "background": "$surface",
          "border": "$borderWidth solid $border",
          "borderRadius": "$radius",
          "boxShadow": "$shadow",
          "color": "$text",
          "padding": "$sp3",
          "backdropFilter": "$backdrop"
        },
        "image": {
          "background": "$surfaceAlt",
          "color": "$muted",
          "borderRadius": "$radiusSm",
          "border": "1px dashed $border"
        },
        "divider": {
          "background": "$border"
        },
        "icon": {
          "color": "$text"
        }
      }
    },
