{
  "format": "nightshift-style-library",
  "version": 1,
  "notes": "Each set has tokens (CSS values) and component render rules. In a rule, $name refers to a token and $sp0..$sp6 to the spacing scale. Edit freely; the tool reads this file on start (when served over http).",
  "tokens": [
    "background",
    "pageTint",
    "surface",
    "surfaceAlt",
    "text",
    "muted",
    "accent",
    "accentText",
    "accentSoft",
    "border",
    "track",
    "mediaBg",
    "ok",
    "warn",
    "danger",
    "info",
