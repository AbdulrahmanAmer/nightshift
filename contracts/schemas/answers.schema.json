{
  "$defs": {
    "AnswersChannel": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "niche": {
          "title": "Niche",
          "type": "string"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "seed_keywords": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Seed Keywords",
          "type": "array"
        }
      },
      "required": [
        "display_name",
        "niche"
      ],
      "title": "AnswersChannel",
      "type": "object"
    },
    "LlmCustom": {
      "additionalProperties": false,
      "properties": {
        "repo": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Repo",
          "type": "string"
        },
        "file": {
          "maxLength": 240,
          "minLength": 6,
          "title": "File",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "repo",
        "file",
        "size"
      ],
      "title": "LlmCustom",
      "type": "object"
    },
    "Voice": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "preset",
          "enum": [
            "preset",
            "design",
            "clone"
          ],
          "title": "Mode",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Ryan",
          "title": "Speaker"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "speed": {
          "default": 1.0,
          "maximum": 1.3,
          "minimum": 0.7,
          "title": "Speed",
          "type": "number"
        }
      },
      "title": "Voice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "channel": {
      "$ref": "#/$defs/AnswersChannel"
    },
    "voice": {
      "$ref": "#/$defs/Voice",
      "default": {
        "mode": "preset",
        "speaker": "Ryan",
        "description": null,
        "name": null,
        "speed": 1.0
      }
    },
    "voice_ref_audio_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice Ref Audio Path"
    },
    "voice_ref_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice Ref Text"
    },
    "voice_rights_confirmed": {
      "default": false,
      "title": "Voice Rights Confirmed",
      "type": "boolean"
    },
    "pexels_api_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pexels Api Key"
    },
    "pixabay_api_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pixabay Api Key"
    },
    "masters_per_week": {
      "default": 1,
      "title": "Masters Per Week",
      "type": "integer"
    },
    "run_time": {
      "default": "03:00",
      "pattern": "^\\d{2}:\\d{2}$",
      "title": "Run Time",
      "type": "string"
    },
    "install_code": {
      "default": true,
      "title": "Install Code",
      "type": "boolean"
    },
    "allow_cpu": {
      "default": false,
      "title": "Allow Cpu",
      "type": "boolean"
    },
    "home_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Home Path"
    },
    "models_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Models Source"
    },
    "llm_tier": {
      "default": "small",
      "enum": [
        "small",
        "balanced",
        "best"
      ],
      "title": "Llm Tier",
      "type": "string"
    },
    "llm_custom": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmCustom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "restore_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Restore From"
    },
    "owner_name": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Name"
    },
    "ui_theme": {
      "default": "dark",
      "enum": [
        "light",
        "dark",
        "soft"
      ],
      "title": "Ui Theme",
      "type": "string"
    },
    "models_source_kind": {
      "default": "internet",
      "enum": [
        "internet",
        "folder",
        "drive_zip"
      ],
      "title": "Models Source Kind",
      "type": "string"
    }
  },
  "required": [
    "channel"
  ],
  "title": "Answers",
  "type": "object"
}
