            "type": "string"
          },
          "title": "Extract",
          "type": "array"
        },
        "dest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dest"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "url"
      ],
      "title": "BinPin",
      "type": "object"
    },
    "HfFile": {
      "additionalProperties": false,
      "properties": {
